<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DofusSlice.Game</RootNamespace>
    <LangVersion>12</LangVersion>
    <!-- DesktopGL is cross-platform (Windows/macOS/Linux) via OpenGL + SDL. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Gum.MonoGame" Version="2026.7.6.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Committed default art + the (gitignored) local override folder, copied next to the exe. -->
    <None Include="assets-default\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ui\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="maps\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DofusSlice.Core\DofusSlice.Core.csproj" />
  </ItemGroup>

</Project>
