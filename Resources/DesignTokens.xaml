<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         WipShare design tokens - translated from app.css (Claude Design).
         Surfaces, text, accent, status; Inter (UI) / JetBrains Mono (values).
         Shared by every desktop surface (first-run, countdown, pill).
         ============================================================ -->

    <!-- ===== Colors ===== -->
    <Color x:Key="BgColor">#FF08090A</Color>
    <Color x:Key="SurfaceColor">#FF0F1011</Color>
    <Color x:Key="Surface2Color">#FF16171A</Color>
    <Color x:Key="Surface3Color">#FF1D1E22</Color>
    <Color x:Key="HairlineColor">#14FFFFFF</Color>
    <Color x:Key="HairlineStrongColor">#24FFFFFF</Color>

    <Color x:Key="FgColor">#FFF7F8F8</Color>
    <Color x:Key="Fg2Color">#FF8A8F98</Color>
    <Color x:Key="Fg3Color">#FF787C85</Color>

    <!-- Accent is neutral white (the brand "key colour" is white, not a hue). -->
    <Color x:Key="AccentColor">#FFF7F8F8</Color>
    <Color x:Key="AccentHiColor">#FFFFFFFF</Color>
    <Color x:Key="AccentDimColor">#24FFFFFF</Color>

    <!-- Primary button: light fill with dark text (never white-on-white). -->
    <Color x:Key="PrimaryColor">#FFE9EAED</Color>
    <Color x:Key="PrimaryHiColor">#FFFFFFFF</Color>
    <Color x:Key="OnPrimaryColor">#FF0B0C0D</Color>

    <Color x:Key="OkColor">#FF3FB950</Color>
    <Color x:Key="WarnColor">#FFD29922</Color>
    <Color x:Key="ErrColor">#FFE35D6A</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="HairlineStrongBrush" Color="{StaticResource HairlineStrongColor}" />

    <SolidColorBrush x:Key="FgBrush" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="Fg2Brush" Color="{StaticResource Fg2Color}" />
    <SolidColorBrush x:Key="Fg3Brush" Color="{StaticResource Fg3Color}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHiBrush" Color="{StaticResource AccentHiColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHiBrush" Color="{StaticResource PrimaryHiColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />

    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="ErrBrush" Color="{StaticResource ErrColor}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFFFF" />

    <!-- ===== Type ===== -->
    <!-- Inter / JetBrains Mono aren't guaranteed installed; fall back to the
         closest Windows faces so layout stays faithful without bundling fonts. -->
    <FontFamily x:Key="SansFont">Inter, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

    <!-- ===== Radii ===== -->
    <CornerRadius x:Key="Radius4">4</CornerRadius>
    <CornerRadius x:Key="Radius6">6</CornerRadius>
    <CornerRadius x:Key="Radius8">8</CornerRadius>
    <CornerRadius x:Key="Radius12">12</CornerRadius>

    <!-- ============================================================
         Buttons - single shared template; each variant sets its own colors
         and hover triggers (Background uses TemplateBinding so Style.Triggers
         can recolor it without a per-variant template).
         ============================================================ -->
    <ControlTemplate x:Key="BtnTemplate" TargetType="Button">
        <Border x:Name="bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True" />
        </Border>
    </ControlTemplate>

    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource BtnTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource BtnTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryHiBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Fg2Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource BtnTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A bare link-style button (the "Skip for now" affordance). -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Fg3Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         Text input - rounded surface field with an accent focus ring
         approximated by swapping the border to accent on keyboard focus.
         ============================================================ -->
    <Style x:Key="InputBase" TargetType="TextBox">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource FgBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="ring"
                            BorderBrush="Transparent"
                            BorderThickness="3"
                            CornerRadius="8"
                            Margin="-3">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource AccentDimBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Centered mono code field (the invite code). Carries an error flag via
         Tag="error" → red ring, set from code-behind on a rejected code. -->
    <Style x:Key="CodeInput" TargetType="TextBox" BasedOn="{StaticResource InputBase}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="error">
                <Setter Property="BorderBrush" Value="{StaticResource ErrBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================
         kbd chip - small key cap (Ctrl / Shift / R). Compose as
         <Border Style="{StaticResource KbdChip}"><TextBlock Style="{StaticResource KbdText}" .../></Border>
         ============================================================ -->
    <Style x:Key="KbdChip" TargetType="Border">
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="KbdText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Common TextBlock roles ===== -->
    <Style x:Key="LabelMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Fg3Brush}" />
    </Style>

</ResourceDictionary>
