<Window x:Class="WipShare.Client.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        MaxHeight="820"
        Width="556"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="{StaticResource SansFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- toggle switch (CheckBox) -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="32" Height="19" CornerRadius="9.5"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                            <Ellipse x:Name="thumb" Width="13" Height="13" HorizontalAlignment="Left"
                                     Margin="2,0,2,0" Fill="{StaticResource Fg2Brush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="thumb" Property="Fill" Value="{StaticResource WhiteBrush}" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- small inline action button (Change / Set up) -->
        <Style x:Key="BtnAct" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface3Brush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- chip dropdown trigger (countdown) -->
        <Style x:Key="ChipSelect" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- popup menu row -->
        <Style x:Key="MenuItemBtn" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource Fg2Brush}" />
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="9,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                                <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- overlay scrollbar: a thin pill thumb that floats over the right margin
             (no reserved gutter), fading in while the window is hovered - design's
             custom .cscroll. 4px wide, 6px on hover; white 16% → 30% → 38% on drag. -->
        <Style x:Key="OverlayScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="32" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- fixed thin width (centered in the 11px lane); only the fill opacity changes -->
                                                <Border x:Name="th" Width="3" HorizontalAlignment="Center" CornerRadius="1.5" Background="#29FFFFFF" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="th" Property="Background" Value="#4DFFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="th" Property="Background" Value="#6BFFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollViewer that overlays the scrollbar over the content (no gutter). -->
        <Style x:Key="OverlayScroll" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Margin="{TemplateBinding Padding}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Style="{StaticResource OverlayScrollBar}"
                                       Orientation="Vertical"
                                       HorizontalAlignment="Right"
                                       Width="11"
                                       Margin="0,8,4,8"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer margin = drop-shadow room. -->
    <Border Margin="18"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid x:Name="ContentRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Border Grid.Row="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                    Background="#06FFFFFF" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Grid Width="12" Height="12" VerticalAlignment="Center">
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="3" />
                            <Ellipse Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,2,2,0" Fill="{StaticResource BgBrush}" />
                        </Grid>
                        <TextBlock Text="Settings" Margin="9,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource Fg2Brush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="46" Height="36" Click="OnCloseClick" Cursor="Hand" ToolTip="Close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cb" Background="Transparent">
                                    <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{StaticResource Fg2Brush}"
                                          StrokeThickness="1" Width="10" Height="10" Stretch="None"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cb" Property="Background" Value="#C03039" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== Body ===== -->
            <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Margin="22,22,22,22">
                    <StackPanel.Resources>
                        <Style TargetType="Border" x:Key="GrpList">
                            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter Property="CornerRadius" Value="10" />
                        </Style>
                    </StackPanel.Resources>

                    <!-- ===== RECORDING ===== -->
                    <StackPanel Margin="0,0,0,24">
                        <StackPanel Margin="2,0,2,10">
                            <TextBlock Text="Recording" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                            <TextBlock Text="How a capture is taken." FontSize="12.5" Foreground="{StaticResource Fg3Brush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource GrpList}">
                            <StackPanel>
                                <!-- hotkey rebind (hero) -->
                                <Grid Margin="15" x:Name="HkRow">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Recording shortcut" FontSize="14" FontWeight="Medium" Foreground="{StaticResource FgBrush}" />
                                        <TextBlock Text="The global key combination that starts a capture." FontSize="12.5"
                                                   Foreground="{StaticResource Fg3Brush}" Margin="0,2,0,0" />
                                        <!-- feedback (invalid / set) -->
                                        <StackPanel x:Name="HkFeedback" Orientation="Horizontal" Margin="0,9,0,0" Visibility="Collapsed">
                                            <Ellipse x:Name="HkFeedbackDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0" Fill="{StaticResource ErrBrush}" />
                                            <TextBlock x:Name="HkFeedbackText" FontSize="12.5" VerticalAlignment="Center" Foreground="{StaticResource ErrBrush}" TextWrapping="Wrap" MaxWidth="320" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <!-- default -->
                                        <StackPanel x:Name="HkDefault" Orientation="Horizontal">
                                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource HairlineBrush}"
                                                    BorderThickness="1" CornerRadius="8" Height="34" Padding="11,0" VerticalAlignment="Center">
                                                <StackPanel x:Name="ComboView" Orientation="Horizontal" VerticalAlignment="Center" />
                                            </Border>
                                            <Button x:Name="HkChange" Style="{StaticResource BtnAct}" Height="34" Margin="8,0,0,0" Content="Change" Click="OnHkChangeClick" />
                                        </StackPanel>
                                        <!-- capturing -->
                                        <Border x:Name="HkListen" Visibility="Collapsed" Height="34" Padding="13,0" CornerRadius="8"
                                                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock x:Name="HkListenText" Text="Press a key combination…" FontSize="13" FontWeight="Medium"
                                                           Foreground="{StaticResource AccentHiBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <!-- candidate confirm -->
                                        <StackPanel x:Name="HkConfirm" Visibility="Collapsed" Orientation="Horizontal">
                                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource HairlineStrongBrush}"
                                                    BorderThickness="1" CornerRadius="8" Height="34" Padding="11,0" VerticalAlignment="Center">
                                                <StackPanel x:Name="CandCombo" Orientation="Horizontal" VerticalAlignment="Center" />
                                            </Border>
                                            <Button x:Name="HkSet" Style="{StaticResource BtnPrimary}" Height="34" Margin="8,0,0,0" Content="Set" Click="OnHkSetClick" />
                                            <Button x:Name="HkCancel" Style="{StaticResource BtnAct}" Width="34" Height="34" Padding="0" Margin="6,0,0,0" Click="OnHkCancelClick" ToolTip="Cancel">
                                                <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{StaticResource Fg2Brush}" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" Width="10" Height="10" Stretch="None" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <Border Height="1" Background="{StaticResource HairlineBrush}" />
                                <!-- countdown -->
                                <Grid Margin="15,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Countdown before recording" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource FgBrush}" />
                                        <TextBlock Text="Wait three seconds after you select a region before recording starts." FontSize="12.5"
                                                   Foreground="{StaticResource Fg3Brush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <ToggleButton x:Name="CountdownChip" Style="{StaticResource ChipSelect}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="CountdownVal" Text="3 seconds" VerticalAlignment="Center" />
                                                <Path Width="7" Height="7" Margin="8,1,0,0" Stretch="None" Data="M0,0 L3.5,3.5 L7,0"
                                                      Stroke="{StaticResource Fg3Brush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <Popup IsOpen="{Binding IsChecked, ElementName=CountdownChip, Mode=TwoWay}" StaysOpen="False"
                                               Placement="Bottom" PlacementTarget="{Binding ElementName=CountdownChip}"
                                               HorizontalOffset="0" VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource HairlineStrongBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="150">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.5" Color="#000000" />
                                                </Border.Effect>
                                                <StackPanel>
                                                    <Button Style="{StaticResource MenuItemBtn}" Click="OnCountdown3Click">
                                                        <Grid>
                                                            <TextBlock Text="3 seconds" VerticalAlignment="Center" />
                                                            <Path x:Name="Cd3Check" Data="M3,8.5 L6.5,12 L13,4.5" Width="13" Height="13" Stretch="None"
                                                                  HorizontalAlignment="Right" Stroke="{StaticResource AccentHiBrush}" StrokeThickness="2"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                        </Grid>
                                                    </Button>
                                                    <Button Style="{StaticResource MenuItemBtn}" Click="OnCountdownOffClick">
                                                        <Grid>
                                                            <TextBlock Text="Off" VerticalAlignment="Center" />
                                                            <Path x:Name="CdOffCheck" Data="M3,8.5 L6.5,12 L13,4.5" Width="13" Height="13" Stretch="None"
                                                                  HorizontalAlignment="Right" Stroke="{StaticResource AccentHiBrush}" StrokeThickness="2"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                                                        </Grid>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== SHARING ===== -->
                    <StackPanel Margin="0,0,0,24">
                        <StackPanel Margin="2,0,2,10">
                            <TextBlock Text="Sharing" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                            <TextBlock Text="What happens the moment a capture finishes." FontSize="12.5" Foreground="{StaticResource Fg3Brush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource GrpList}">
                            <StackPanel>
                                <!-- auto-copy -->
                                <Grid Margin="15,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Auto-copy link" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource FgBrush}" />
                                        <TextBlock Text="Put the share link on the clipboard as soon as the upload completes." FontSize="12.5"
                                                   Foreground="{StaticResource Fg3Brush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="AutoCopyToggle" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="OnAutoCopyClick" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource HairlineBrush}" />
                                <!-- open link after recording -->
                                <Grid Margin="15,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Open link after recording" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource FgBrush}" />
                                        <TextBlock Text="Open the clip in your browser as soon as it finishes uploading." FontSize="12.5"
                                                   Foreground="{StaticResource Fg3Brush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="OpenLinkToggle" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="OnOpenLinkClick" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource HairlineBrush}" />
                                <!-- keep local -->
                                <Grid Margin="15,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Keep a local copy" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource FgBrush}" />
                                        <TextBlock Text="Save the original .mp4 to your computer after uploading." FontSize="12.5"
                                                   Foreground="{StaticResource Fg3Brush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" x:Name="KeepLocalToggle" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="OnKeepLocalClick" />
                                </Grid>
                                <!-- save location (sub-row, revealed when keep-local on) -->
                                <Border x:Name="LocRowSep" Height="1" Background="{StaticResource HairlineBrush}" />
                                <Grid x:Name="LocRow" Margin="30,13,15,13" Background="#04FFFFFF">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Save location" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource FgBrush}" />
                                        <TextBlock Text="Where your local .mp4 copies are kept." FontSize="12.5" Foreground="{StaticResource Fg3Brush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="LocPath" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Fg2Brush}"
                                                   MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button x:Name="BtnFolder" Style="{StaticResource BtnAct}" Content="Change" Click="OnChangeFolderClick" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== CONNECTION ===== -->
                    <StackPanel Margin="0,0,0,24">
                        <StackPanel Margin="2,0,2,10">
                            <TextBlock Text="Connection" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                            <TextBlock Text="Your access to sharing." FontSize="12.5" Foreground="{StaticResource Fg3Brush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource GrpList}">
                            <Grid Margin="15,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Invite code" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource FgBrush}" />
                                    <TextBlock x:Name="ConnSub" FontSize="12.5" Foreground="{StaticResource Fg3Brush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ConnDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{StaticResource OkBrush}" />
                                    <TextBlock x:Name="ConnLabel" FontSize="13" Foreground="{StaticResource Fg2Brush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button x:Name="ConnAction" Style="{StaticResource BtnAct}" Content="Change" Click="OnConnActionClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ===== GENERAL ===== -->
                    <StackPanel>
                        <StackPanel Margin="2,0,2,10">
                            <TextBlock Text="General" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                            <TextBlock Text="App behavior." FontSize="12.5" Foreground="{StaticResource Fg3Brush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Style="{StaticResource GrpList}">
                            <Grid Margin="15,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Launch at startup" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource FgBrush}" />
                                    <TextBlock Text="Open WipShare automatically when you sign in." FontSize="12.5" Foreground="{StaticResource Fg3Brush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="OnStartupClick" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
