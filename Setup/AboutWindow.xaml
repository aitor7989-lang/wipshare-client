<Window x:Class="WipShare.Client.Setup.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About WipShare"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="416"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="{StaticResource SansFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Margin="18" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid x:Name="ContentRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Border Grid.Row="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                    Background="#06FFFFFF" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Grid Width="12" Height="12" VerticalAlignment="Center">
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="3" />
                            <Ellipse Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Fill="{StaticResource BgBrush}" />
                        </Grid>
                        <TextBlock Text="About" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Fg2Brush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="46" Height="36" Click="OnCloseClick" Cursor="Hand" ToolTip="Close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cb" Background="Transparent">
                                    <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{StaticResource Fg2Brush}" StrokeThickness="1"
                                          Width="10" Height="10" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cb" Property="Background" Value="#C03039" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- body -->
            <StackPanel Grid.Row="1">
                <!-- top -->
                <StackPanel HorizontalAlignment="Center" Margin="28,32,28,24">
                    <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Ellipse Width="112" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#245E6AD2" Offset="0" />
                                    <GradientStop Color="#005E6AD2" Offset="0.7" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="15" />
                        <Ellipse Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,13,0" Fill="{StaticResource BgBrush}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="WipShare" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" VerticalAlignment="Center" />
                        <Border Margin="9,0,0,0" VerticalAlignment="Center" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="7,2">
                            <TextBlock x:Name="VersionText" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Fg2Brush}" Text="0.0.0" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Quick screen clips for artists. Press a hotkey, get a link."
                               FontSize="13" Foreground="{StaticResource Fg3Brush}" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="260" Margin="0,8,0,0" />
                </StackPanel>

                <!-- website row -->
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="22,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Website" FontSize="13" Foreground="{StaticResource Fg3Brush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center">
                            <Hyperlink x:Name="WebsiteLink" Click="OnWebsiteClick" TextDecorations="None" Foreground="{StaticResource AccentHiBrush}">
                                <TextBlock x:Name="WebsiteText" Text="wipshare-web.vercel.app" />
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- your clips row -->
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="22,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Your clips" FontSize="13" Foreground="{StaticResource Fg3Brush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center">
                            <Hyperlink x:Name="YourClipsLink" Click="OnYourClipsClick" TextDecorations="None" Foreground="{StaticResource AccentHiBrush}">
                                <TextBlock x:Name="YourClipsText" Text="wipshare-web.vercel.app/me" />
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- foot / credits -->
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Margin="22,14,22,16" HorizontalAlignment="Center">
                        <TextBlock Text="Made for the studio." FontSize="12" Foreground="{StaticResource Fg3Brush}" TextAlignment="Center" />
                        <TextBlock Text="Built with .NET · NHotkey · Hardcodet.NotifyIcon.Wpf" FontSize="11"
                                   Foreground="{StaticResource Fg3Brush}" Opacity="0.8" TextAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
