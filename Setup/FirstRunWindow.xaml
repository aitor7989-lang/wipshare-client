<Window x:Class="WipShare.Client.Setup.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WipShare"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        FontFamily="{StaticResource SansFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Outer margin leaves room for the drop shadow under AllowsTransparency. -->
    <Border Width="480" Margin="18"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Border Grid.Row="0" x:Name="TitleBar"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="0,0,0,1"
                    Background="#06FFFFFF"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <!-- mini mark -->
                        <Grid Width="12" Height="12" VerticalAlignment="Center">
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="3" />
                            <Ellipse Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,2,2,0" Fill="{StaticResource BgBrush}" />
                        </Grid>
                        <TextBlock Text="WipShare" Margin="9,0,0,0" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{StaticResource Fg2Brush}" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="CloseButton" Width="46" Height="36"
                            Click="OnCloseClick" Cursor="Hand"
                            ToolTip="Close (skip setup)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cb" Background="Transparent">
                                    <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{StaticResource Fg2Brush}"
                                          StrokeThickness="1" Width="10" Height="10" Stretch="None"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cb" Property="Background" Value="#C03039" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== Body ===== -->
            <StackPanel Grid.Row="1" x:Name="BodyPanel" Margin="32,32,32,26">

                <!-- head -->
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="40" Height="40" HorizontalAlignment="Center">
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="11" />
                        <Ellipse Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,9,9,0" Fill="{StaticResource BgBrush}" />
                    </Grid>
                    <TextBlock Text="Welcome to WipShare" Margin="0,14,0,0" HorizontalAlignment="Center"
                               FontSize="22" FontWeight="Medium" Foreground="{StaticResource FgBrush}" />
                    <TextBlock Text="Quick screen clips for artists. Press a hotkey, get a link."
                               Margin="0,8,0,0" MaxWidth="320" TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="14" Foreground="{StaticResource Fg2Brush}" />
                </StackPanel>

                <!-- hotkey hint -->
                <Border Margin="0,22,0,0" HorizontalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="CAPTURE" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource Fg3Brush}" />
                        <Border Width="1" Height="18" Margin="10,0" Background="{StaticResource HairlineBrush}" />
                        <Border Style="{StaticResource KbdChip}">
                            <TextBlock Style="{StaticResource KbdText}" Text="Ctrl" />
                        </Border>
                        <TextBlock Text="+" Margin="4,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Fg3Brush}" />
                        <Border Style="{StaticResource KbdChip}">
                            <TextBlock Style="{StaticResource KbdText}" Text="Shift" />
                        </Border>
                        <TextBlock Text="+" Margin="4,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Fg3Brush}" />
                        <Border Style="{StaticResource KbdChip}">
                            <TextBlock Style="{StaticResource KbdText}" Text="R" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- form -->
                <StackPanel Margin="0,22,0,0">
                    <TextBlock Text="INVITE CODE" Margin="0,0,0,6"
                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource Fg3Brush}" />
                    <Grid>
                        <TextBox x:Name="CodeBox" Style="{StaticResource CodeInput}"
                                 MaxLength="200" TextChanged="OnCodeChanged" />
                        <TextBlock x:Name="Placeholder" Text="WIP-XXXX-XXXX" IsHitTestVisible="False"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}" FontSize="14"
                                   Foreground="{StaticResource Fg3Brush}" />
                    </Grid>
                </StackPanel>

                <!-- actions -->
                <StackPanel Margin="0,22,0,0" HorizontalAlignment="Stretch">
                    <Button x:Name="ConnectButton" Style="{StaticResource BtnPrimary}" Height="36"
                            HorizontalAlignment="Stretch" Click="OnConnectClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- spinner (verifying) -->
                            <Grid x:Name="ConnectSpinner" Width="13" Height="13" Margin="0,0,8,0" Visibility="Collapsed">
                                <Ellipse Width="13" Height="13" Stroke="#40FFFFFF" StrokeThickness="1.5" />
                                <Ellipse Width="13" Height="13" Stroke="#FFFFFFFF" StrokeThickness="1.5" StrokeDashArray="4 100">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="SpinAngle" CenterX="6.5" CenterY="6.5" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <!-- check (success) -->
                            <Path x:Name="ConnectCheck" Data="M3,8 L6.5,11.5 L13,5" Visibility="Collapsed"
                                  Stroke="{StaticResource BgBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="14" Height="14" Stretch="None" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ConnectLabel" Text="Connect" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SkipButton" Style="{StaticResource LinkButton}" Margin="0,14,0,0"
                            Content="Skip for now" Click="OnSkipClick" />
                </StackPanel>

                <!-- inline status (reserved height so layout never jumps) -->
                <Grid Margin="0,16,0,0" MinHeight="18">
                    <StackPanel x:Name="StatusPanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,8,0"
                                 VerticalAlignment="Center" Fill="{StaticResource Fg3Brush}" />
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource Fg3Brush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
